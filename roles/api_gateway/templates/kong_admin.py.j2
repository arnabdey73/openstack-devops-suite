#!/usr/bin/env python3
"""
Kong Admin API Management Script
Provides functions to manage Kong configuration via API
"""

import requests
import json
import sys
import time
from typing import Dict, List, Optional

class KongAdmin:
    def __init__(self, admin_url: str = "http://localhost:8001"):
        self.admin_url = admin_url.rstrip('/')
        self.session = requests.Session()
        self.session.headers.update({
            'Content-Type': 'application/json',
            'Accept': 'application/json'
        })

    def check_health(self) -> bool:
        """Check if Kong Admin API is healthy"""
        try:
            response = self.session.get(f"{self.admin_url}/status", timeout=10)
            return response.status_code == 200
        except Exception as e:
            print(f"Health check failed: {e}")
            return False

    def wait_for_ready(self, timeout: int = 120) -> bool:
        """Wait for Kong to be ready"""
        start_time = time.time()
        while time.time() - start_time < timeout:
            if self.check_health():
                print("Kong is ready!")
                return True
            print("Waiting for Kong to be ready...")
            time.sleep(5)
        return False

    def create_service(self, service_config: Dict) -> bool:
        """Create or update a Kong service"""
        try:
            service_name = service_config.get('name')
            
            # Check if service exists
            response = self.session.get(f"{self.admin_url}/services/{service_name}")
            
            if response.status_code == 200:
                # Update existing service
                response = self.session.patch(
                    f"{self.admin_url}/services/{service_name}",
                    data=json.dumps(service_config)
                )
            else:
                # Create new service
                response = self.session.post(
                    f"{self.admin_url}/services",
                    data=json.dumps(service_config)
                )
            
            if response.status_code in [200, 201]:
                print(f"Service '{service_name}' configured successfully")
                return True
            else:
                print(f"Failed to configure service '{service_name}': {response.text}")
                return False
                
        except Exception as e:
            print(f"Error configuring service: {e}")
            return False

    def create_route(self, route_config: Dict) -> bool:
        """Create or update a Kong route"""
        try:
            route_name = route_config.get('name')
            service_name = route_config.get('service', {}).get('name')
            
            # Create route for service
            response = self.session.post(
                f"{self.admin_url}/services/{service_name}/routes",
                data=json.dumps(route_config)
            )
            
            if response.status_code in [200, 201, 409]:
                print(f"Route '{route_name}' configured successfully")
                return True
            else:
                print(f"Failed to configure route '{route_name}': {response.text}")
                return False
                
        except Exception as e:
            print(f"Error configuring route: {e}")
            return False

    def enable_plugin(self, plugin_config: Dict) -> bool:
        """Enable a Kong plugin"""
        try:
            plugin_name = plugin_config.get('name')
            
            # Enable plugin
            response = self.session.post(
                f"{self.admin_url}/plugins",
                data=json.dumps(plugin_config)
            )
            
            if response.status_code in [200, 201, 409]:
                print(f"Plugin '{plugin_name}' enabled successfully")
                return True
            else:
                print(f"Failed to enable plugin '{plugin_name}': {response.text}")
                return False
                
        except Exception as e:
            print(f"Error enabling plugin: {e}")
            return False

    def create_consumer(self, consumer_config: Dict) -> bool:
        """Create or update a Kong consumer"""
        try:
            consumer_name = consumer_config.get('username')
            
            # Check if consumer exists
            response = self.session.get(f"{self.admin_url}/consumers/{consumer_name}")
            
            if response.status_code == 200:
                # Update existing consumer
                response = self.session.patch(
                    f"{self.admin_url}/consumers/{consumer_name}",
                    data=json.dumps(consumer_config)
                )
            else:
                # Create new consumer
                response = self.session.post(
                    f"{self.admin_url}/consumers",
                    data=json.dumps(consumer_config)
                )
            
            if response.status_code in [200, 201]:
                print(f"Consumer '{consumer_name}' configured successfully")
                return True
            else:
                print(f"Failed to configure consumer '{consumer_name}': {response.text}")
                return False
                
        except Exception as e:
            print(f"Error configuring consumer: {e}")
            return False

    def get_services(self) -> List[Dict]:
        """Get list of all services"""
        try:
            response = self.session.get(f"{self.admin_url}/services")
            if response.status_code == 200:
                return response.json().get('data', [])
            return []
        except Exception as e:
            print(f"Error getting services: {e}")
            return []

    def get_plugins(self) -> List[Dict]:
        """Get list of all plugins"""
        try:
            response = self.session.get(f"{self.admin_url}/plugins")
            if response.status_code == 200:
                return response.json().get('data', [])
            return []
        except Exception as e:
            print(f"Error getting plugins: {e}")
            return []

    def delete_service(self, service_name: str) -> bool:
        """Delete a Kong service"""
        try:
            response = self.session.delete(f"{self.admin_url}/services/{service_name}")
            if response.status_code in [204, 404]:
                print(f"Service '{service_name}' deleted successfully")
                return True
            else:
                print(f"Failed to delete service '{service_name}': {response.text}")
                return False
        except Exception as e:
            print(f"Error deleting service: {e}")
            return False

    def clear_cache(self) -> bool:
        """Clear Kong cache"""
        try:
            response = self.session.delete(f"{self.admin_url}/cache")
            if response.status_code in [204]:
                print("Kong cache cleared successfully")
                return True
            else:
                print(f"Failed to clear cache: {response.text}")
                return False
        except Exception as e:
            print(f"Error clearing cache: {e}")
            return False

def main():
    """Main function for CLI usage"""
    if len(sys.argv) < 2:
        print("Usage: kong_admin.py <command> [args]")
        print("Commands: health, wait, clear-cache")
        sys.exit(1)
    
    command = sys.argv[1]
    admin_url = sys.argv[2] if len(sys.argv) > 2 else "http://localhost:8001"
    
    kong = KongAdmin(admin_url)
    
    if command == "health":
        if kong.check_health():
            print("Kong is healthy")
            sys.exit(0)
        else:
            print("Kong is not healthy")
            sys.exit(1)
    elif command == "wait":
        if kong.wait_for_ready():
            sys.exit(0)
        else:
            print("Kong failed to become ready")
            sys.exit(1)
    elif command == "clear-cache":
        if kong.clear_cache():
            sys.exit(0)
        else:
            sys.exit(1)
    else:
        print(f"Unknown command: {command}")
        sys.exit(1)

if __name__ == "__main__":
    main()