# Kong Configuration File
# Generated by Ansible

# Database settings
database = {{ kong_database_type }}
pg_host = {{ kong_database_host }}
pg_port = {{ kong_database_port }}
pg_database = {{ kong_database_name }}
pg_user = {{ kong_database_user }}
pg_password = {{ kong_database_password }}
pg_ssl = off
pg_ssl_verify = off

# Network settings
proxy_listen = 0.0.0.0:{{ kong_proxy_port }} reuseport backlog=16384
{% if kong_ssl_enabled %}
proxy_listen = 0.0.0.0:{{ kong_proxy_ssl_port }} ssl http2 reuseport backlog=16384
ssl_cert = {{ kong_ssl_cert_path }}
ssl_cert_key = {{ kong_ssl_key_path }}
{% endif %}

# Admin API
admin_listen = 0.0.0.0:{{ kong_admin_port }} reuseport backlog=16384
{% if kong_ssl_enabled %}
admin_listen = 0.0.0.0:{{ kong_admin_ssl_port }} ssl http2 reuseport backlog=16384
{% endif %}

# Admin GUI
{% if kong_admin_gui_enabled %}
admin_gui_listen = 0.0.0.0:8002
admin_gui_url = http://{{ kong_admin_host }}:8002
admin_gui_path = /
{% endif %}

# Logging
log_level = {{ kong_log_level }}
error_log = {{ kong_error_log_path }}
access_log = {{ kong_access_log_path }}

# Process management
nginx_worker_processes = {{ kong_worker_processes }}
nginx_worker_connections = {{ kong_worker_connections }}

# Custom nginx directives
nginx_http_client_max_body_size = {{ kong_client_max_body_size }}

# Caching
db_cache_ttl = {{ kong_db_cache_ttl }}
db_cache_neg_ttl = {{ kong_db_cache_neg_ttl }}

# Upstream keepalive
upstream_keepalive_pool_size = {{ kong_upstream_keepalive_pool_size }}
upstream_keepalive_max_requests = {{ kong_upstream_keepalive_max_requests }}
upstream_keepalive_idle_timeout = {{ kong_upstream_keepalive }}

# Plugins
plugins = bundled{% if kong_custom_plugins %},{{ kong_custom_plugins | join(',') }}{% endif %}

# Additional security headers
headers = off
trusted_ips = 0.0.0.0/0,::/0

# Prefix path
prefix = /var/lib/kong

# Status page
status_listen = 0.0.0.0:8100

# Real IP headers
real_ip_header = X-Real-IP
real_ip_recursive = on

# Lua settings
lua_package_path = /opt/kong/?.lua;;

# Nginx user
nginx_user = kong kong

# Nginx PID
nginx_pid = /var/run/kong/nginx.pid

# Anonymous reports
anonymous_reports = off

# Vitals
vitals = {{ 'on' if kong_vitals_enabled else 'off' }}

{% if kong_cluster_enabled %}
# Clustering
cluster_listen = {{ kong_cluster_listen }}
cluster_encrypt_key = {{ kong_cluster_encrypt_key }}
{% endif %}

{% if kong_dev_portal_enabled %}
# Developer Portal
portal = on
portal_gui_listen = {{ kong_dev_portal_host }}:{{ kong_dev_portal_port }}
{% endif %}

# Enterprise features
{% if kong_rbac_enabled %}
enforce_rbac = on
{% endif %}

{% if kong_workspaces_enabled %}
workspaces = on
{% endif %}