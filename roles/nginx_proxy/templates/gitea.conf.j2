# Gitea SCM Server Configuration
# Optimized for Git repository operations and web interface

upstream gitea_servers {
    server {{ hostvars[groups['gitea_servers'][0]]['ansible_host'] }}:3000 max_fails=3 fail_timeout=30s;
    {% if groups['gitea_servers']|length > 1 %}
    {% for host in groups['gitea_servers'][1:] %}
    server {{ hostvars[host]['ansible_host'] }}:3000 max_fails=3 fail_timeout=30s;
    {% endfor %}
    {% endif %}
    keepalive 32;
}

# Gitea HTTP Server
server {
    listen 80;
    server_name gitea.{{ nginx_domain }};

    {% if nginx_ssl_enabled %}
    # Redirect to HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl{% if nginx_http2_enabled %} http2{% endif %};
    server_name gitea.{{ nginx_domain }};

    # SSL Configuration
    ssl_certificate {{ nginx_ssl_cert }};
    ssl_certificate_key {{ nginx_ssl_key }};
    ssl_protocols {{ nginx_ssl_protocols }};
    ssl_ciphers {{ nginx_ssl_ciphers }};
    ssl_prefer_server_ciphers {{ nginx_ssl_prefer_server_ciphers }};
    
    {% if nginx_hsts_enabled %}
    add_header Strict-Transport-Security "max-age={{ nginx_hsts_max_age }}; includeSubDomains" always;
    {% endif %}
    {% endif %}

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Client settings for Git operations
    client_max_body_size {{ gitea_max_body_size }};
    client_body_timeout 300s;
    client_header_timeout 60s;

    # Proxy settings optimized for Git
    proxy_connect_timeout 10s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;
    proxy_buffering off;
    proxy_request_buffering off;

    # Common proxy headers
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;

    # Main Gitea location
    location / {
        {% if rate_limit_enabled %}
        limit_req zone=git burst=100 nodelay;
        {% endif %}

        # Handle WebSocket connections for real-time notifications
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_pass http://gitea_servers;

        # Special handling for Git HTTP operations
        location ~ ^/.*\.git/.*$ {
            # Higher limits for Git operations
            client_max_body_size 2g;
            proxy_read_timeout 600s;
            proxy_send_timeout 600s;
            
            # Disable rate limiting for Git push/pull
            limit_req off;
            
            proxy_pass http://gitea_servers;
        }

        # API endpoints
        location ~ ^/api/ {
            {% if rate_limit_enabled %}
            limit_req zone=api burst=50 nodelay;
            {% endif %}
            
            # CORS headers for API access
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept" always;
            
            if ($request_method = OPTIONS) {
                return 204;
            }
            
            proxy_pass http://gitea_servers;
        }

        # Webhook endpoints (no rate limiting)
        location /api/v1/repos/*/hooks {
            limit_req off;
            proxy_pass http://gitea_servers;
        }
    }

    # Health check
    location /api/healthz {
        access_log off;
        proxy_pass http://gitea_servers;
    }

    # Static assets caching
    location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        proxy_pass http://gitea_servers;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Logging
    access_log {{ nginx_access_log }} combined;
    error_log {{ nginx_error_log }} warn;
}