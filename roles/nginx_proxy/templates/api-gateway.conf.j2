# NGINX API Gateway Configuration for Jenkins + Gitea DevOps Suite
# This configuration provides comprehensive API gateway functionality

# Rate limiting zones
limit_req_zone $binary_remote_addr zone=general:{{ rate_limit_zone_size }} rate={{ rate_limit_default }};
limit_req_zone $binary_remote_addr zone=api:{{ rate_limit_zone_size }} rate={{ rate_limit_api }};
limit_req_zone $binary_remote_addr zone=git:{{ rate_limit_zone_size }} rate={{ rate_limit_git }};

# Upstream definitions for load balancing and health checks
upstream gitea_backend {
    server {{ hostvars[groups['gitea_servers'][0]]['ansible_host'] }}:3000 max_fails=3 fail_timeout=30s;
    {% if groups['gitea_servers']|length > 1 %}
    {% for host in groups['gitea_servers'][1:] %}
    server {{ hostvars[host]['ansible_host'] }}:3000 max_fails=3 fail_timeout=30s;
    {% endfor %}
    {% endif %}
    keepalive 32;
}

upstream jenkins_backend {
    server {{ hostvars[groups['jenkins_servers'][0]]['ansible_host'] }}:8080 max_fails=3 fail_timeout=30s;
    {% if groups['jenkins_servers']|length > 1 %}
    {% for host in groups['jenkins_servers'][1:] %}
    server {{ hostvars[host]['ansible_host'] }}:8080 max_fails=3 fail_timeout=30s;
    {% endfor %}
    {% endif %}
    keepalive 32;
}

upstream nexus_backend {
    server {{ hostvars[groups['nexus_servers'][0]]['ansible_host'] }}:8081 max_fails=3 fail_timeout=30s;
    keepalive 16;
}

upstream keycloak_backend {
    server {{ hostvars[groups['keycloak_servers'][0]]['ansible_host'] }}:8080 max_fails=3 fail_timeout=30s;
    keepalive 16;
}

upstream rancher_backend {
    server {{ hostvars[groups['rancher_servers'][0]]['ansible_host'] }}:80 max_fails=3 fail_timeout=30s;
    keepalive 16;
}

# Map for API versioning
map $request_uri $api_version {
    default "v1";
    ~^/api/v(?<version>\d+)/ $version;
}

# Map for service routing
map $request_uri $backend_service {
    default "dashboard";
    ~^/gitea/ "gitea";
    ~^/jenkins/ "jenkins";
    ~^/nexus/ "nexus";
    ~^/keycloak/ "keycloak";
    ~^/rancher/ "rancher";
    ~^/api/v\d+/repos/ "gitea";
    ~^/api/v\d+/jenkins/ "jenkins";
    ~^/api/v\d+/nexus/ "nexus";
    ~^/api/v\d+/auth/ "keycloak";
}

# SSL and security configuration
ssl_session_cache shared:SSL:50m;
ssl_session_timeout 1d;
ssl_session_tickets off;

# API Gateway Server Block
server {
    listen 80;
    listen [::]:80;
    server_name {{ nginx_domain }} api.{{ nginx_domain }};
    
    # Redirect HTTP to HTTPS
    {% if nginx_ssl_enabled %}
    return 301 https://$server_name$request_uri;
    {% endif %}
}

server {
    {% if nginx_ssl_enabled %}
    listen 443 ssl{% if nginx_http2_enabled %} http2{% endif %};
    listen [::]:443 ssl{% if nginx_http2_enabled %} http2{% endif %};
    
    ssl_certificate {{ nginx_ssl_cert }};
    ssl_certificate_key {{ nginx_ssl_key }};
    ssl_protocols {{ nginx_ssl_protocols }};
    ssl_ciphers {{ nginx_ssl_ciphers }};
    ssl_prefer_server_ciphers {{ nginx_ssl_prefer_server_ciphers }};
    
    {% if nginx_hsts_enabled %}
    add_header Strict-Transport-Security "max-age={{ nginx_hsts_max_age }}; includeSubDomains" always;
    {% endif %}
    {% else %}
    listen 80;
    listen [::]:80;
    {% endif %}
    
    server_name {{ nginx_domain }} api.{{ nginx_domain }};
    
    # Security headers
    {% if nginx_xss_protection_enabled %}
    add_header X-XSS-Protection "1; mode=block" always;
    {% endif %}
    {% if nginx_clickjacking_protection_enabled %}
    add_header X-Frame-Options "SAMEORIGIN" always;
    {% endif %}
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' wss: ws:;" always;
    
    # API Gateway specific headers
    add_header X-API-Gateway "NGINX-DevOps-Suite" always;
    add_header X-API-Version "$api_version" always;
    
    # Client settings
    client_max_body_size {{ nginx_client_max_body_size }};
    client_body_timeout 60s;
    client_header_timeout 60s;
    
    # Proxy settings
    proxy_connect_timeout 5s;
    proxy_send_timeout {{ nginx_proxy_timeout }}s;
    proxy_read_timeout {{ nginx_proxy_timeout }}s;
    proxy_buffering on;
    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;
    
    # Common proxy headers
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
    
    # Health check endpoint
    location /health {
        access_log off;
        return 200 '{"status":"healthy","timestamp":"$time_iso8601","version":"{{ api_gateway_version }}"}';
        add_header Content-Type application/json;
    }
    
    # Metrics endpoint for monitoring
    location /metrics {
        {% if rate_limit_enabled %}
        limit_req zone=general burst=10 nodelay;
        {% endif %}
        
        # Return basic NGINX metrics
        access_log off;
        stub_status on;
        allow 127.0.0.1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;
    }
    
    # =================================================================
    # API ENDPOINTS - Centralized API access with versioning
    # =================================================================
    
    # Gitea API (Git repositories, users, organizations)
    location ~ ^/api/v\d+/repos/ {
        {% if rate_limit_enabled %}
        limit_req zone=api burst=20 nodelay;
        {% endif %}
        
        # Enable CORS for API access
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept" always;
        
        if ($request_method = OPTIONS) {
            return 204;
        }
        
        # Forward to Gitea API
        rewrite ^/api/v\d+/repos/(.*)$ /api/v1/$1 break;
        proxy_pass http://gitea_backend;
        
        # API-specific headers
        proxy_set_header Accept application/json;
        proxy_hide_header X-Frame-Options;
    }
    
    # Jenkins API (jobs, builds, pipelines)
    location ~ ^/api/v\d+/jenkins/ {
        {% if rate_limit_enabled %}
        limit_req zone=api burst=20 nodelay;
        {% endif %}
        
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept, Jenkins-Crumb" always;
        
        if ($request_method = OPTIONS) {
            return 204;
        }
        
        # Forward to Jenkins API
        rewrite ^/api/v\d+/jenkins/(.*)$ /api/$1 break;
        proxy_pass http://jenkins_backend;
        
        # Jenkins-specific headers
        proxy_set_header Jenkins-Crumb $http_jenkins_crumb;
    }
    
    # Nexus API (artifacts, repositories)
    location ~ ^/api/v\d+/nexus/ {
        {% if rate_limit_enabled %}
        limit_req zone=api burst=15 nodelay;
        {% endif %}
        
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept" always;
        
        if ($request_method = OPTIONS) {
            return 204;
        }
        
        # Forward to Nexus API
        rewrite ^/api/v\d+/nexus/(.*)$ /service/rest/$1 break;
        proxy_pass http://nexus_backend;
    }
    
    # Keycloak Authentication API
    location ~ ^/api/v\d+/auth/ {
        {% if rate_limit_enabled %}
        limit_req zone=api burst=25 nodelay;
        {% endif %}
        
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept" always;
        
        if ($request_method = OPTIONS) {
            return 204;
        }
        
        # Forward to Keycloak API
        rewrite ^/api/v\d+/auth/(.*)$ /auth/$1 break;
        proxy_pass http://keycloak_backend;
    }
    
    # =================================================================
    # WEB INTERFACES - Service-specific routing
    # =================================================================
    
    # Gitea Web Interface
    location /gitea/ {
        {% if rate_limit_enabled %}
        limit_req zone=git burst=50 nodelay;
        {% endif %}
        
        client_max_body_size {{ gitea_max_body_size }};
        
        # Handle WebSocket connections for real-time updates
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # Forward to Gitea
        rewrite ^/gitea/(.*)$ /$1 break;
        rewrite ^/gitea$ / break;
        proxy_pass http://gitea_backend;
        
        # Gitea-specific settings
        proxy_buffering off;
        proxy_request_buffering off;
    }
    
    # Jenkins Web Interface  
    location /jenkins/ {
        {% if rate_limit_enabled %}
        limit_req zone=general burst=30 nodelay;
        {% endif %}
        
        client_max_body_size {{ jenkins_max_body_size }};
        
        # Handle WebSocket connections for build logs
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # Forward to Jenkins
        rewrite ^/jenkins/(.*)$ /$1 break;
        rewrite ^/jenkins$ / break;
        proxy_pass http://jenkins_backend;
        
        # Jenkins-specific settings
        proxy_buffering off;
        proxy_request_buffering off;
        
        # Handle Jenkins CLI
        location ~ ^/jenkins/cli {
            proxy_pass http://jenkins_backend;
            proxy_buffering off;
        }
    }
    
    # Nexus Web Interface
    location /nexus/ {
        {% if rate_limit_enabled %}
        limit_req zone=general burst=20 nodelay;
        {% endif %}
        
        client_max_body_size 2g;  # Large artifacts
        
        # Forward to Nexus
        rewrite ^/nexus/(.*)$ /$1 break;
        rewrite ^/nexus$ / break;
        proxy_pass http://nexus_backend;
        
        # Docker registry support
        location ~ ^/nexus/v2/ {
            proxy_pass http://nexus_backend;
            proxy_set_header Docker-Distribution-Api-Version registry/2.0;
        }
    }
    
    # Keycloak Web Interface
    location /keycloak/ {
        {% if rate_limit_enabled %}
        limit_req zone=general burst=20 nodelay;
        {% endif %}
        
        # Forward to Keycloak
        rewrite ^/keycloak/(.*)$ /$1 break;
        rewrite ^/keycloak$ /auth break;
        proxy_pass http://keycloak_backend;
    }
    
    # Rancher Web Interface
    location /rancher/ {
        {% if rate_limit_enabled %}
        limit_req zone=general burst=20 nodelay;
        {% endif %}
        
        # Handle WebSocket connections for terminal access
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # Forward to Rancher
        rewrite ^/rancher/(.*)$ /$1 break;
        rewrite ^/rancher$ / break;
        proxy_pass http://rancher_backend;
        
        # Rancher-specific settings
        proxy_buffering off;
    }
    
    # =================================================================
    # DASHBOARD & STATIC CONTENT
    # =================================================================
    
    # Main dashboard
    location / {
        {% if rate_limit_enabled %}
        limit_req zone=general burst=10 nodelay;
        {% endif %}
        
        try_files $uri $uri/ @dashboard;
    }
    
    location @dashboard {
        # Serve the main dashboard page
        try_files /index.html =404;
        root /var/www/html;
        
        # Cache static assets
        location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
            access_log off;
        }
    }
    
    # Static assets
    location /assets/ {
        root /var/www/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        
        # Enable gzip for static assets
        gzip_static on;
    }
    
    # =================================================================
    # ERROR HANDLING
    # =================================================================
    
    # Custom error pages
    error_page 404 /error/404.html;
    error_page 500 502 503 504 /error/50x.html;
    
    location = /error/404.html {
        root /var/www/html;
        internal;
    }
    
    location = /error/50x.html {
        root /var/www/html;
        internal;
    }
    
    # Rate limit error page
    error_page 429 /error/429.html;
    location = /error/429.html {
        root /var/www/html;
        internal;
    }
}

# =================================================================
# SERVICE-SPECIFIC SERVERS (for direct access)
# =================================================================

# Direct Gitea access (optional)
server {
    listen 3000;
    server_name gitea.{{ nginx_domain }};
    
    {% if rate_limit_enabled %}
    limit_req zone=git burst=100 nodelay;
    {% endif %}
    
    location / {
        proxy_pass http://gitea_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Direct Jenkins access (optional)
server {
    listen 8080;
    server_name jenkins.{{ nginx_domain }};
    
    {% if rate_limit_enabled %}
    limit_req zone=general burst=50 nodelay;
    {% endif %}
    
    location / {
        proxy_pass http://jenkins_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Jenkins-specific WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}