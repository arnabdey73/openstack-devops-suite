# Vault environment configuration
# Generated by Ansible - DO NOT EDIT MANUALLY

# Vault server configuration
VAULT_ADDR=http://{{ vault_address }}:{{ vault_port }}
VAULT_API_ADDR=http://{{ vault_address }}:{{ vault_port }}
{% if vault_cluster_enabled | default(false) %}
VAULT_CLUSTER_ADDR=http://{{ vault_address }}:{{ vault_cluster_port }}
{% endif %}

# Vault logging
VAULT_LOG_LEVEL={{ vault_log_level }}
{% if vault_log_file is defined and vault_log_file != '' %}
VAULT_LOG_FILE={{ vault_log_file }}
{% endif %}

# Vault UI
VAULT_UI={{ vault_ui_enabled | lower }}

# Performance settings
VAULT_DEFAULT_LEASE_TTL={{ vault_default_lease_ttl | default('168h') }}
VAULT_MAX_LEASE_TTL={{ vault_max_lease_ttl | default('720h') }}

# Security settings
VAULT_DISABLE_MLOCK={{ vault_disable_mlock | default(false) | lower }}

# Development/testing settings (DO NOT USE IN PRODUCTION)
{% if vault_dev_mode | default(false) %}
VAULT_DEV_MODE=true
VAULT_DEV_ROOT_TOKEN_ID={{ vault_dev_root_token | default('root') }}
{% endif %}

# Custom environment variables
{% if vault_custom_env_vars is defined %}
{% for key, value in vault_custom_env_vars.items() %}
{{ key }}={{ value }}
{% endfor %}
{% endif %}