# HashiCorp Vault configuration file
# Generated by Ansible - DO NOT EDIT MANUALLY

# Storage backend configuration
storage "{{ vault_storage_backend }}" {
{% if vault_storage_backend == 'file' %}
  path = "{{ vault_storage_path }}"
{% elif vault_storage_backend == 'consul' %}
  address = "{{ consul_address | default('127.0.0.1:8500') }}"
  path = "{{ consul_vault_path | default('vault/') }}"
{% endif %}
}

# API listener configuration
listener "tcp" {
  address = "{{ vault_address }}:{{ vault_port }}"
{% if vault_tls_enabled %}
  tls_cert_file = "{{ vault_tls_cert_file }}"
  tls_key_file = "{{ vault_tls_key_file }}"
  tls_ca_file = "{{ vault_tls_ca_file }}"
{% else %}
  tls_disable = 1
{% endif %}
}

{% if vault_cluster_enabled | default(false) %}
# Cluster listener configuration
listener "tcp" {
  address = "{{ vault_address }}:{{ vault_cluster_port }}"
  cluster_address = "{{ vault_address }}:{{ vault_cluster_port }}"
  tls_disable = 1
}

# High availability configuration
ha_storage "{{ vault_ha_storage_backend | default('consul') }}" {
{% if vault_ha_storage_backend == 'consul' %}
  address = "{{ consul_address | default('127.0.0.1:8500') }}"
  path = "{{ consul_vault_ha_path | default('vault-ha/') }}"
{% endif %}
}

# Cluster configuration
cluster_addr = "http://{{ vault_address }}:{{ vault_cluster_port }}"
api_addr = "http://{{ vault_address }}:{{ vault_port }}"
{% endif %}

# UI configuration
ui = {{ vault_ui_enabled | lower }}

# Logging configuration
log_level = "{{ vault_log_level }}"
{% if vault_log_file is defined and vault_log_file != '' %}
log_file = "{{ vault_log_file }}"
{% endif %}

# Performance configuration
default_lease_ttl = "{{ vault_default_lease_ttl | default('168h') }}"
max_lease_ttl = "{{ vault_max_lease_ttl | default('720h') }}"

# Security configuration
disable_mlock = {{ vault_disable_mlock | default(false) | lower }}
disable_cache = {{ vault_disable_cache | default(false) | lower }}

{% if vault_seal_type is defined and vault_seal_type != 'shamir' %}
# Auto-unseal configuration
seal "{{ vault_seal_type }}" {
{% if vault_seal_type == 'awskms' %}
  region = "{{ aws_region }}"
  kms_key_id = "{{ aws_kms_key_id }}"
{% elif vault_seal_type == 'azurekeyvault' %}
  tenant_id = "{{ azure_tenant_id }}"
  client_id = "{{ azure_client_id }}"
  client_secret = "{{ azure_client_secret }}"
  vault_name = "{{ azure_vault_name }}"
  key_name = "{{ azure_key_name }}"
{% elif vault_seal_type == 'gcpckms' %}
  project = "{{ gcp_project }}"
  region = "{{ gcp_region }}"
  key_ring = "{{ gcp_key_ring }}"
  crypto_key = "{{ gcp_crypto_key }}"
{% endif %}
}
{% endif %}

# Telemetry configuration (optional)
{% if vault_telemetry_enabled | default(false) %}
telemetry {
  prometheus_retention_time = "{{ vault_prometheus_retention | default('24h') }}"
  disable_hostname = {{ vault_telemetry_disable_hostname | default(false) | lower }}
  
{% if vault_statsd_address is defined %}
  statsd_address = "{{ vault_statsd_address }}"
{% endif %}

{% if vault_statsite_address is defined %}
  statsite_address = "{{ vault_statsite_address }}"
{% endif %}
}
{% endif %}

# Enterprise configuration (if applicable)
{% if vault_enterprise | default(false) %}
license_path = "{{ vault_license_path }}"

# Entropy Augmentation (Enterprise)
{% if vault_entropy_augmentation | default(false) %}
entropy "seal" {
  mode = "augmentation"
}
{% endif %}

# Namespaces (Enterprise)
{% if vault_namespaces is defined %}
{% for namespace in vault_namespaces %}
# Namespace: {{ namespace }}
{% endfor %}
{% endif %}
{% endif %}